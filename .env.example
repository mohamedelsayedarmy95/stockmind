# ── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stockmind
DB_PASSWORD=  # Must be set in actual .env
DB_DATABASE=stockmind
# Set to true for hosted Postgres (e.g. Neon) — required, their endpoints reject
# plaintext connections. Leave false for local docker-compose Postgres.
DB_SSL=false
# ── Firebase Admin SDK (Render Environment) ───────────────
# Get these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=stockmind-e2560
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@stockmind-e2560.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
